# Same Supabase project as the web app — copy the values from the root
# .env.local. Only the publishable (anon) key is allowed here: RLS protects
# the data, and anything in this file ships inside the app bundle.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public origin of the deployed Next.js app whose API routes the app calls
# with the Supabase bearer token (APP_BASE_URL when set on the server,
# otherwise the deployment URL). For local development against the web dev
# server use http://localhost:3100 — on a real device, replace localhost
# with your machine's LAN IP.
EXPO_PUBLIC_API_URL=

# Public Sentry DSN for native crash reporting. Leave empty to disable all
# reporting locally. SENTRY_AUTH_TOKEN, SENTRY_ORG and SENTRY_PROJECT belong
# in EAS Build secrets only and must never use the EXPO_PUBLIC_ prefix.
EXPO_PUBLIC_SENTRY_DSN=
