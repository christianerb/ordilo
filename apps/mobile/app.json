{
  "expo": {
    "name": "Ordilo",
    "slug": "ordilo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ordilo",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ordilo.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Ordilo braucht die Kamera, um Dokumente zu scannen.",
        "NSMicrophoneUsageDescription": "Ordilo braucht das Mikrofon, damit du per Sprache Fragen stellen und suchen kannst.",
        "NSSpeechRecognitionUsageDescription": "Ordilo erkennt deine gesprochenen Fragen, damit du sie nicht tippen musst."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ordilo.app",
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FDFCFA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FDFCFA"
        }
      ],
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Ordilo braucht das Mikrofon, damit du per Sprache Fragen stellen und suchen kannst.",
          "speechRecognitionPermission": "Ordilo erkennt deine gesprochenen Fragen, damit du sie nicht tippen musst."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ordilo braucht Zugriff auf Fotos, damit du Dokumente auswählen kannst."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b0396312-ad25-4c2c-afc4-25de0dd14f42"
      }
    },
    "owner": "chrtothaizzo"
  }
}
