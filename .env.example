# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://vrodyamhdxrspnaxzdtg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (LLM extraction + embeddings)
OPENAI_API_KEY=your-openai-api-key

# Datalab (Chandra OCR 2)
DATALAB_API_KEY=your-datalab-api-key

# Pipeline (optional)
# OCR/analyze jobs run server-side by default and are drained after upload.
# Set PIPELINE_MODE=sync to disable the background queue for local debugging.
PIPELINE_MODE=
# Bearer secret required by the job worker endpoint (POST /api/jobs/run).
# Vercel Cron sends CRON_SECRET automatically; either name works.
JOBS_RUNNER_SECRET=

# Internal admin dashboard (server-only)
# Comma-separated, normalized admin email addresses. Use a long random code
# and a separate random session secret (at least 32 characters).
ADMIN_EMAILS=
ADMIN_ACCESS_CODE=
ADMIN_SESSION_SECRET=

# Encrypted secret storage (server-only)
# 32-byte key for AES-256-GCM encryption of hidden values (passwords etc.)
# stored in documents.secret. Generate with: openssl rand -base64 32
# NEVER commit the real key. If lost, all stored secrets become unreadable
# and must be re-entered (recovery = reset, not decrypt).
SECRETS_ENCRYPTION_KEY=

# Sentry (error monitoring + tracing)
# Create a project at https://sentry.io and copy the DSN.
# The public DSN goes to the browser; the server DSN is secret.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Auth token for source map uploads during build (create at Sentry → Settings → Auth Tokens)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Resend inbound email (server-only)
# Verify this receiving domain and point its Resend `email.received` webhook
# to https://<app-domain>/api/email/inbound.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
INBOUND_EMAIL_DOMAIN=
